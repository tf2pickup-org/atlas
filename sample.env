# NODE_ENV=production # or development
NODE_ENV=development

# Logging level
# Possible values: fatal, error, warn, info, debug, trace
LOG_LEVEL=info

# MongoDB connect string
MONGODB_URI=mongodb://localhost:27017/atlas

# Comma-separated list of accepted heartbeat secrets.
# Hand one out per operator; several instances may share one secret.
ATLAS_SECRETS=secret1,secret2
